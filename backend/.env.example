# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/connectbook?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Expiry
JWT_EXPIRE=7d

# Encryption Key for Face Embeddings
ENCRYPTION_KEY=your_32_character_encryption_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI API Keys (Multi-Provider Fallback)
# Get Gemini key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get OpenRouter key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
